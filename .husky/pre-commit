#!/usr/bin/env sh

# Preserve the terminal's Node and pnpm selections, then append fallback
# locations for Git GUI apps with a minimal PATH.
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin:$HOME/.npm-global/bin:$HOME/Library/pnpm"
export PNPM_CONFIG_MINIMUM_RELEASE_AGE="0"

if [ -x "./node_modules/.bin/lint-staged" ]; then
	./node_modules/.bin/lint-staged
elif command -v pnpm >/dev/null 2>&1; then
	pnpm exec lint-staged
else
	npx --no-install lint-staged
fi